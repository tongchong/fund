{
    "$schema": "https://turborepo.org/schema.json",
    "tasks": {
      "build": {
        "dependsOn": [
          "^build"
        ],
        "outputs": [
          ".next/**",
          "build/**"
        ]
      },
      "lint": {
        "inputs": [
          "**/*.proto",
          "**/*.tsx",
          "**/*.ts"
        ],
        "outputs": [
          ".eslintcache"
        ]
      },
      "test": {
        "outputs": []
      }
    }
  }
